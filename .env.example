# Production env — inlined by Vite at build time (COPY .env.prod .env)
VITE_SERVER_URL=https://api-skeleton.venturo.id
VITE_ASSETS_DIR=

# Firebase Web SDK — projectId WAJIB sama dengan FIREBASE_PROJECT_ID di BE
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- SIAKANG local development ---------------------------------------------
# Backend base URL. BE confirmed localhost:8080, and CORS already allows this
# app's dev origin (localhost:8081) plus the Authorization header.
# VITE_SERVER_URL=http://localhost:8080

# Serve /market/v1/* from src/shared/lib/market-mock.ts instead of the backend,
# so FE can build against the signed contract before BE lands (SPEC 4).
# Leave unset/false in committed code. QA always runs with mocks OFF.
# VITE_USE_MOCKS=false
